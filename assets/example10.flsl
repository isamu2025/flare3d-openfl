/**
 * Flare3D Shader Language v2.0.
 * 
 * Multiple directional lights.
 */

use namespace flare.filters;
use namespace flare.transforms;

namespace vertexLights
{
	param WORLD world;
	
	input NORMAL normal;
	
	// start processing the lights.
	
	// calculates the vertex normal to use for all lights.
	float3 wNormal = normal * world.xyz;
	
	// we need to initialize lightColor, othwersie, we'll be writting a
	// non initialized variable.
	float3 lightColor = 0;
	
	// process light directions and colors.
	void directionalLight( float3 dir, float3 color ) 
	{
		lightColor += color * saturate( dot( wNormal, dir ) );
	}
	
	// pass the lights values to the output fragment.
	float4 lightsValues() 
	{
		// we're using per vertex lights, so we need to send the result color to the fragment shader 
		// through an interpolate variable.
		// this way, we will only need one instruction in the fragment program to output the color.
		interpolated float4 iLightColor = float4( lightColor, 1 );
		
		return iLightColor;
	}
}

technique test
{   
	param float3 lights[2];
	lights[0] = float3( 0.5, 0.7, -0.8 );
	lights[1] = float3( 0.7, 0.2, 0.2 );
	
	param float3 colors[2] <ui = "color">;
	colors[0] = float3( 0.2, 0.3, 0.4 );
	colors[1] = float3( 0.6 );
	
	vertexLights.directionalLight( lights[0], colors[0] );
	vertexLights.directionalLight( lights[1], colors[1] );
	
	output vertex = transform();
	output fragment = vertexLights.lightsValues();
}