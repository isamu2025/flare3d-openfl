
use namespace flare;
use namespace flare.transforms;
use namespace flare.filters;

// scene.targetTexture is passed directly by the engine.
TARGET_TEXTURE texture;

param float4 gamma = float4( 2.2, 2.2, 2.2, 1 );

technique main 
{
	output vertex = position.xyzw;
	output fragment = pow( sampler2D( texture, iUV0 ), 1 / gamma );
}